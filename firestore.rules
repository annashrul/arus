        && incoming().ownerId == existing().ownerId
        && incoming().clubId == existing().clubId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isOwnerOfExisting() || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'sessionType', 'ageGroup', 'dayOfWeek', 'sessionDate', 'startTime', 'endTime', 'poolLocation', 'laneInfo', 'coachName', 'targetDistanceMeters', 'notes', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(scheduleId) && (isOwnerOfExisting() || isAdmin());
    }

    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && isValidId(invoiceId) && (isOwnerOfExisting() || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(invoiceId)
        && isValidInvoice(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isOwningClub(incoming().clubId)
        && isOwningAthlete(incoming().athleteId);
      allow update: if isVerifiedUser()
        && isValidId(invoiceId)
        && isValidInvoice(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().clubId == existing().clubId
        && incoming().athleteId == existing().athleteId
        && incoming().invoiceNumber == existing().invoiceNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwnerOfExisting() && (
            // Action: Edit invoice details or submit/sync payment proof while pending
            (existing().status in ['Belum Lunas', 'Jatuh Tempo', 'Menunggu Verifikasi']
              && incoming().status in ['Belum Lunas', 'Jatuh Tempo', 'Menunggu Verifikasi', 'Dibatalkan']
              && incoming().diff(existing()).affectedKeys().hasOnly(['athleteName', 'parentName', 'parentPhone', 'periodMonth', 'category', 'description', 'amount', 'dueDate', 'status', 'paymentMethod', 'paymentToken', 'proofImageDataUrl', 'proofPayerName', 'proofMethod', 'proofNote', 'proofSubmittedAt', 'paymentRejectionReason', 'notes', 'updatedAt'])) ||
            // Action: Quick-confirm or mark invoice paid (Lunas)
            (existing().status in ['Belum Lunas', 'Jatuh Tempo', 'Menunggu Verifikasi']
              && incoming().status == 'Lunas'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paidDate', 'paymentMethod', 'paymentRejectionReason', 'notes', 'updatedAt']))
          ))
        );
      allow delete: if isVerifiedUser() && isValidId(invoiceId) && (isOwnerOfExisting() || isAdmin());
    }

    match /paymentRequests/{tokenId} {
      // Split-collection parent portal: no PII (phone/email/address); access requires knowing the 24-64 char cryptographic tokenId
      allow get: if isValidPaymentToken(tokenId) && (
        (isSignedIn() && (isOwnerOfExisting() || isAdmin())) ||
        resource != null
      );
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidPaymentToken(tokenId)
        && isValidPaymentRequest(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isOwningClub(incoming().clubId)
        && isOwningInvoice(incoming().invoiceId);
      allow update: if isValidPaymentToken(tokenId)
        && isValidPaymentRequest(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().clubId == existing().clubId
        && incoming().invoiceId == existing().invoiceId
        && incoming().invoiceNumber == existing().invoiceNumber
        && incoming().athleteName == existing().athleteName
        && incoming().periodMonth == existing().periodMonth
        && incoming().description == existing().description
        && incoming().amount == existing().amount
        && incoming().dueDate == existing().dueDate
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Verified admin or club owner updating verification status or syncing club payment instructions
          (isVerifiedUser() && (isOwnerOfExisting() || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly(['clubName', 'clubCity', 'bankName', 'bankAccountNumber', 'bankAccountHolder', 'qrisPayload', 'qrisMerchantName', 'status', 'proofImageDataUrl', 'payerName', 'paymentMethod', 'proofNote', 'submittedAt', 'verifiedAt', 'rejectionReason', 'updatedAt'])) ||
          // Tier 2: Parent uploading payment receipt image via unguessable token link
          (resource != null
            && existing().status in ['Menunggu Pembayaran', 'Ditolak']
            && incoming().status == 'Menunggu Verifikasi'
            && ('proofImageDataUrl' in incoming())
            && incoming().proofImageDataUrl.size() > 30
            && isValidProofDataUrl(incoming().proofImageDataUrl)
            && ('payerName' in incoming())
            && incoming().payerName.size() >= 2
            && incoming().payerName.size() <= 100
            && ('paymentMethod' in incoming())
            && incoming().paymentMethod in ['Transfer Bank', 'QRIS', 'Tunai', 'Lainnya']
            && (!('rejectionReason' in incoming()) || incoming().rejectionReason == '')
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'proofImageDataUrl', 'payerName', 'paymentMethod', 'proofNote', 'submittedAt', 'rejectionReason', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidPaymentToken(tokenId) && (isOwnerOfExisting() || isAdmin());
    }

    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && isValidId(attendanceId) && (isOwnerOfExisting() || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
