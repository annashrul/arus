rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /payment-proofs/{ownerId}/{invoiceId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == ownerId;
      allow create: if request.auth != null && request.auth.uid == ownerId
        && fileName.matches('^[a-zA-Z0-9_-]+\\.(jpg|jpeg|png|webp|pdf)$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
      allow update, delete: if false;
    }
  }
}
